---
import { SITE } from '../lib/site.ts';
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { title, description, image = SITE.image, type = 'website', jsonLd, noindex = false } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, SITE.url).href;
---
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="kalam.dev" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
